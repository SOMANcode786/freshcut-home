generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                  Int      @id
  name                String
  slug                String   @unique
  urdu                String
  cat                 String
  icon                String
  image               String
  altText             String?  @default("")
  description         String
  shortDescription    String?  @default("")
  nutritionSummary    Json?
  nutrients           Json?
  healthBenefits      Json?
  cutDescription      String?  @default("")
  cookingUses         Json?
  storageInstructions String?  @default("")
  hygieneInformation String?  @default("")
  faq                 Json?
  prices              Json
  sale                Boolean  @default(false)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([cat])
  @@index([active])
}

model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  customerName  String
  phone         String
  address       String
  area          String
  payment       String
  notes         String   @default("")
  items         Json
  total         Int
  status        String   @default("New")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

model Review {
  id        Int      @id @default(autoincrement())
  customer  String
  city      String   @default("Karachi")
  rating    Int      @default(5)
  text      String
  date      String?
  verified  Boolean  @default(true)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}
